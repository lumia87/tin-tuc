95 57.7596 91.6162 60.8388L12.9797 106.24C7.64641 109.319 0.979746 105.47 0.979747 99.3114L0.979751 8.50985C0.979751 2.35144 7.64642 -1.49756 12.9798 1.58165L91.6162 46.9824Z\" fill=\"#fff\"></path>\n                                </svg>\n                                35:14                            </div>\n                                            </div>\n                                            <p>How Roblox Uses AI</p>\n                                    </div>\n                            </div>\n        </div>\n    </div>\n\n    <script>\n        // Add player to queue when DOM is ready\n        if (document.readyState === 'loading') {\n            document.addEventListener('DOMContentLoaded', function() {\n                if (window.FSBlogYouTube && window.FSBlogYouTube.addPlayerToQueue) {\n                    window.FSBlogYouTube.addPlayerToQueue(\"yt_player_718790\", \"G1Mxl40Joo8\");\n                }\n            });\n        } else {\n            if (window.FSBlogYouTube && window.FSBlogYouTube.addPlayerToQueue) {\n                window.FSBlogYouTube.addPlayerToQueue(\"yt_player_718790\", \"G1Mxl40Joo8\");\n            }\n        }\n    </script>\n\n\n\n<p class=\"wp-block-paragraph\">In this short conversation, he shares how a health decision saved his son&#8217;s life and how it changed how he eats, why bureaucracy compounds unless you actively destroy it, monitoring your mind before making decisions, and why the best products often improve by removing complexity.</p>\n\n\n\n<p class=\"wp-block-paragraph\">It&#8217;s time to Listen and Learn.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><strong>Available Now: <a href=\"https://www.youtube.com/watch?v=G1Mxl40Joo8&amp;feature=youtu.be\">YouTube</a> | <strong><a href=\"https://open.spotify.com/episode/3zRWOkB2JAUtMqJX2VHToK\">Spotify</a></strong></strong> | <strong><a href=\"https://podcasts.apple.com/us/podcast/roblox-ceo-how-to-make-better-decisions-by-fixing-yourself/id990149481?i=1000784066252\">Apple Podcasts</a> | <a href=\"https://fs.blog/knowledge-project-podcast-transcripts/david-baszucki/\">Transcript</a></strong></p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>+&nbsp;<a href=\"https://fs.blog/membership\">Members</a>&nbsp;get the longer, extended version of this conversation, with additional content not included in the public release.&nbsp;</em></p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>++ Note: ‍Shane and guests may hold positions in assets discussed in this episode. This podcast is not investment advice, and is intended for informational and entertainment purposes only. Nothing in this conversation should be considered investment advice, financial guidance, or a recommendation to buy or sell any security. Always do your own due diligence or consult with a qualified financial advisor before making investment decisions.</em></p>\n\n\n\n<p class=\"wp-block-paragraph\"><em>++ Note: This episode discusses health and medical topics for informational purposes only. Shane and his guest are not medical professionals, and nothing in this conversation should be considered medical advice. Please do your own research and consult a qualified healthcare professional before making decisions about your health.</em></p>\n<p>The post <a href=\"https://fs.blog/knowledge-project-podcast/david-baszucki/\">Roblox CEO: How to Make Better Decisions by Fixing Yourself First</a> appeared first on <a href=\"https://fs.blog\">Farnam Street</a>.</p>\n","https://fs.blog/knowledge-project-podcast/brad-jacobs-2/":"\n<p class=\"wp-block-paragraph\">This summer, I&#8217;m revisiting one of my favorite episodes. If you haven’t heard it, now is the time. If you have, it’s a classic and worth listening to again.</p>\n\n\n\n<div class=\"youtube-block\">\n            <div class=\"video-wrapper\">\n            <div class=\"video-default\" data-player=\"yt_player_495568\">\n                <div class=\"video-thumbnail\" style=\"background-image: url(https://i.ytimg.com/vi/pduZ-bfcKAQ/maxresdefault.jpg);\">\n                    <div class=\"video-loader\">\n                        <div class=\"loader-spinner\"></div>\n                    </div>\n                    <button class=\"video-button\" type=\"button\" aria-labelledby=\"video-play-label\">\n                        <span id=\"video-play-label\" class=\"sr-only\">Play</span>\n                    </button>\n                </div>\n                <div id=\"yt_player_495568\" class=\"video-frame\"></div>\n            </div>\n        </div>\n    \n            \n        <div class=\"videos-wrapper\" data-player-id=\"yt_player_495568\">\n        <h3 class=\"videos-title\">Featured clips</h3>\n        <div class=\"videos-row\">\n                                            <div class=\"video-single\" data-time=\"07:50\">\n                    <div class=\"video-image\">\n                                                    <img loading=\"lazy\" decoding=\"async\" width=\"300\" height=\"167\" src=\"https://fs.blog/wp-content/uploads/2026/07/Screenshot-2026-08-04-at-8.42.34-AM-300x167.png\" class=\"attachment-medium size-medium\" alt=\"His Research Process\" srcset=\"https://fs.blog/wp-content/uploads/2026/07/Screenshot-2026-08-04-at-8.42.34-AM-300x167.png 300w, https://fs.blog/wp-content/uploads/2026/07/Screenshot-2026-08-04-at-8.42.34-AM-768x428.png 768w, https://fs.blog/wp-content/uploads/2026/07/Screenshot-2026-08-04-at-8.42.34-AM-1024x571.png 1024w, https://fs.blog/wp-content/uploads/2026/07/Screenshot-2026-08-04-at-8.42.34-AM.png 1537w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" />                                                                            <div class=\"video-timestamp\">\n                                <svg width=\"96\" height=\"108\" viewBox=\"0 0 96 108\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                                    <path d=\"M91.6162 46.9824C96.9495 50.0616 96.9495 57.7596 91.6162 60.8388L12.9797 106.24C7.64641 109.319 0.979746 105.47 0.97